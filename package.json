{
  "name": "reframe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "tsx scripts/dev-worker.ts",
    "prepare:spacejam": "tsx scripts/prepare-spacejam-bundle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build:app && npm run build:worker",
    "build:app": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --loader:.sql=text --loader:.woff2=dataurl --loader:.txt=text --outfile=dist/server/index.js",
    "build:releases": "esbuild src/release-worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/releases/index.js",
    "dev:releases": "tsx scripts/dev-releases.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "eslint": "^10.11.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "miniflare": "^5.20260921.0-alpha",
    "parse5": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  },
  "description": "Evidence-based UI modernization with a visual component board, approved design systems, and static publishing.",
  "license": "MIT",
  "author": "Yoha and Reframe contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoha02/reframe-ui-modernization.git"
  },
  "bugs": {
    "url": "https://github.com/Yoha02/reframe-ui-modernization/issues"
  },
  "homepage": "https://github.com/Yoha02/reframe-ui-modernization#readme",
  "engines": {
    "node": ">=22.14.0"
  }
}
